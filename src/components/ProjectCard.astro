---
import type { Project } from '@/data/projects';
interface Props {
  project: Project;
  number: number;
  /** Cycles the image crop so no two neighbours share a shape. */
  shape?: number;
}
const { project, number, shape = 0 } = Astro.props;
const disciplineLabel: Record<Project['discipline'], string> = {
  DE: 'Data Eng',
  DS: 'Data Science',
  ML: 'Machine Learning',
  AI: 'AI Eng',
};
const aspects = ['aspect-[4/3]', 'aspect-[1/1]', 'aspect-[16/10]', 'aspect-[5/6]'];
// A project may pin its own crop when the artefact's shape demands it.
const aspect = project.aspect ?? aspects[shape % aspects.length];

// Work without a public artefact still belongs on the page — it just isn't
// a link, and shouldn't pretend to be one.
const Tag = project.href ? 'a' : 'div';
const linkProps = project.href
  ? { href: project.href, target: '_blank', rel: 'noreferrer' }
  : {};
---

{/* No card chrome: an image plate and its caption, the way a plate is set
    in a book. The grid around it supplies the structure instead. */}
<Tag {...linkProps} class="group block fade-up">
  <div class={`relative overflow-hidden rounded-[10px] bg-ink/[0.04] ${aspect}`}>
    <img
      src={project.image}
      alt={project.title}
      width="1200"
      height="750"
      loading="lazy"
      decoding="async"
      class="plate-img absolute inset-0 h-full w-full object-cover"
    />
  </div>

  <div class="mt-5 flex items-baseline gap-4">
    <span class="mono-label tnum shrink-0">
      {String(number).padStart(2, '0')}
    </span>
    <div class="min-w-0">
      <h3
        class:list={[
          'heading text-[17px] md:text-[18px] text-ink transition-opacity duration-300',
          project.href && 'group-hover:opacity-60',
        ]}
      >
        {project.title}
      </h3>

      <p class="mt-2.5 text-[13px] leading-relaxed text-muted">
        {project.stack.join(' · ')}
      </p>

      <p class="mt-3.5 mono-label opacity-70">
        {disciplineLabel[project.discipline]}
      </p>
    </div>
  </div>
</Tag>
