---
import { stack } from '@/data/projects';
import SectionHeader from './SectionHeader.astro';
import Scribble from './Scribble.astro';
---

<section id="stack" class="relative">
  <SectionHeader
    index="01"
    label="Toolchain"
    title="Tools I've built with (not a wishlist 😉)."
    kicker="Stack."
  >
    <Scribble slot="note" class="mt-10" note="idempotent, please" tilt={-2.5}>
      f(f(x)) = f(x)
    </Scribble>
  </SectionHeader>

  {/* Rows on the spine, not boxes: group name in the narrow column, the
      tools running wide beside it, separated by hairlines. */}
  <div class="max-w-page mx-auto px-6 md:px-10">
    {
      stack.map((group, gi) => (
        <div class="fade-up" style={`--stagger: ${gi}`}>
          <div class="hairline" aria-hidden="true" />
          <div class="grid grid-cols-12 gap-x-0 md:gap-x-8 py-8 md:py-10">
            <div class="col-span-12 md:col-span-3">
              <h3 class="text-[15px] font-medium tracking-[-0.015em] text-ink">
                {group.label}
              </h3>
              <p class="mt-1.5 mono-label opacity-60 tnum">
                {String(group.items.length).padStart(2, '0')} tools
              </p>
            </div>

            <ul class="col-span-12 md:col-span-9 mt-5 md:mt-0 flex flex-wrap items-center gap-x-7 gap-y-4">
              {group.items.map((item) => (
                <li class="group/item flex items-center gap-2.5 text-[14px] text-muted">
                  {item.logo ? (
                    <img
                      src={item.logo}
                      alt={item.name}
                      width="18"
                      height="18"
                      loading="lazy"
                      class="h-[15px] w-[15px] object-contain opacity-75 transition-opacity duration-500 group-hover/item:opacity-100"
                    />
                  ) : (
                    <span
                      class="inline-grid place-items-center h-[15px] w-[15px] rounded-[2px] border border-border font-mono text-[8px] font-medium text-subtle"
                      aria-hidden="true"
                    >
                      {item.name.charAt(0)}
                    </span>
                  )}
                  {!item.hideLabel && (
                    <span class="transition-colors duration-300 group-hover/item:text-ink">
                      {item.name}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
    <div class="hairline" aria-hidden="true"></div>
  </div>
</section>
