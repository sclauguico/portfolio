---
import Mark from './Mark.astro';

interface Props {
  index: string;
  label: string;
  title: string;
  kicker?: string;
  /** Vertical air above the section. Varied by hand per section so the
      page breathes unevenly, the way a designed page does — identical
      spacing six times over is what makes a layout feel generated. */
  space?: 'tight' | 'normal' | 'loose';
}
const { index, label, title, kicker, space = 'normal' } = Astro.props;

const spacing = {
  tight: 'pt-16 md:pt-20',
  normal: 'pt-24 md:pt-32',
  loose: 'pt-32 md:pt-48',
}[space];
---

{/*
  The spine: section metadata sits in a narrow left column and the title
  starts a third of the way across. Every section hangs off this same edge,
  which is what lets the content grid break the rules further down.
*/}
<header class={`max-w-page mx-auto px-6 md:px-10 pb-10 md:pb-14 ${spacing}`}>
  <div class="hairline fade-up" aria-hidden="true"></div>

  <div class="mt-5 grid grid-cols-12 gap-x-0 md:gap-x-8 items-start">
    <div class="col-span-12 md:col-span-3 fade-up">
      <p class="flex items-center gap-2.5 mono-label">
        <Mark class="mark h-[14px] w-[14px] shrink-0" />
        <span class="text-ink/70">§ {index}</span>
      </p>
      <p class="mt-2 mono-label">{label}</p>
      {Astro.slots.has('note') && <slot name="note" />}
    </div>

    <h2
      class="heading col-span-12 md:col-span-7 mt-5 md:mt-0 max-w-[22ch] text-ink fade-up"
      style="--stagger: 1; font-size: clamp(1.75rem, 3.4vw, 2.6rem);"
    >
      {title}
    </h2>

    {
      kicker && (
        <p class="hidden md:block col-span-2 mono-label opacity-50 text-right fade-up" style="--stagger: 2;">
          {kicker}
        </p>
      )
    }
  </div>
</header>
