---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import StackSection from '@/components/StackSection.astro';
import ProjectsSection from '@/components/ProjectsSection.astro';
import About from '@/components/About.astro';
import Contact from '@/components/Contact.astro';
import Scribble from '@/components/Scribble.astro';
import WorkFigure from '@/components/WorkFigure.astro';
---

<Base>
  <Hero />
  <StackSection />

  <WorkFigure />

  <ProjectsSection
    id="de"
    index="02"
    label="Data Engineering"
    title="Pipelines, warehouses, and the boring bits done right."
    kicker="Selected projects."
    discipline="DE"
    space="tight"
  >
    <Scribble slot="note" class="mt-10" note="Little's Law" tilt={2}>
      L = λW
    </Scribble>
  </ProjectsSection>

  <ProjectsSection
    id="ds"
    index="02.5"
    label="Data Science & Analytics"
    title="Modeling, measuring, making sense of it."
    kicker="Selected projects."
    discipline="DS"
    space="loose"
  >
    <Scribble slot="note" class="mt-10" note="still the whole game" tilt={-2}>
      P(A|B) = P(B|A)·P(A) / P(B)
    </Scribble>
  </ProjectsSection>

  <ProjectsSection
    id="ml"
    index="03"
    label="Machine Learning"
    title="Vision, models, and research that shipped."
    kicker="Selected projects."
    discipline="ML"
    space="normal"
  >
    <Scribble slot="note" class="mt-10" note="bias–variance" tilt={1.5}>
      E[(y − f̂)<sup>2</sup>] = Bias<sup>2</sup> + Var + σ<sup>2</sup>
    </Scribble>
  </ProjectsSection>

  <ProjectsSection
    id="ai"
    index="04"
    label="AI Engineering"
    title="Agents, and the systems around them."
    kicker="Selected projects."
    discipline="AI"
    space="tight"
  >
    <Scribble slot="note" class="mt-10" note="scaled dot-product attention" tilt={-2}>
      softmax(QK<sup>T</sup> / √d<sub>k</sub>) V
    </Scribble>
  </ProjectsSection>

  <About />
  <Contact />
</Base>
